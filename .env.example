# Copy to .env and fill in. `pi` reads these from the environment.

# --- site profile (hospital / care-setting conventions) ----------------
# PI_PROFILE=default_or        # default_or | uk_or | cath_lab | mmor_robotic | /path/to/your.json
# `pi profiles` lists them; `pi run --profile <name>` overrides per run.

# --- LLM provider -------------------------------------------------------
# Auto: uses Groq if GROQ_API_KEY is set, else local Ollama.
# Force with PI_PROVIDER = groq | ollama | gemini
# PI_PROVIDER=groq
# PI_MODEL=qwen/qwen3.8-27b             # groq default (good + has free-tier headroom)
# PI_MODEL=qwen2.5:3b                   # ollama default
# PI_CRITIC_MODEL=openai/gpt-oss-20b    # optional cheaper model for critic checks

# Groq free tier — https://console.groq.com/keys  (no card required)
# NOTE: free tier has per-minute AND per-day token caps. gpt-oss-120b's daily cap
# (200k tok) is small; qwen3 models have more room. The pipeline throttles + degrades
# gracefully, but a long case can still lose a draft to a 429 — just `pi stage <name>` it.
GROQ_API_KEY=

# Gemini free tier — https://aistudio.google.com/apikey  (public data only)
GEMINI_API_KEY=

# --- speech-to-text (only used when the input is audio/video) ----------
# PI_STT=groq                        # default: Groq whisper-large-v3 (hosted, free tier, ~24MB cap)
# PI_STT=local                       # faster-whisper on this machine — pip install '.[local-stt]'
# PI_WHISPER_MODEL=whisper-large-v3   # groq model id, or a faster-whisper size (base/small/medium) for local
# oversized files are auto-split if ffmpeg is on PATH

# --- tuning ------------------------------------------------------------
# Groq free tier = 8,000 tokens/MINUTE per model. Defaults suit short (<400 turn) transcripts.
# For long MM-OR-style transcripts:  PI_MIN_SPACING=19 PI_WINDOW_TURNS=90 PI_SWEEP_CHUNK=300
# PI_MIN_SPACING=5.0     # seconds between ALL hosted LLM calls (global throttle)
# PI_WINDOW_TURNS=60     # transcript turns per extraction window
# PI_SWEEP_CHUNK=220     # turns per whole-transcript safety-sweep chunk
# PI_MAX_PROMPT_CHARS=11000  # hard cap on any single extraction prompt (avoids 413)
# PI_CONCURRENCY=1       # parallel extraction windows
# PI_RETRIES=4           # attempts per call on 429/5xx
# PI_MAX_BACKOFF=40      # give up rather than wait longer than this (daily-quota 429s)
# PI_TIMEOUT=150         # read timeout per call
# PI_REASONING=low       # reasoning_effort for gpt-oss models
# OLLAMA_HOST=http://localhost:11434
