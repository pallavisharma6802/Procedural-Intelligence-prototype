# Copy to .env and fill in.

# Site profile: default_or | uk_or | cath_lab | mmor_robotic | primary_care | /path/to/your.json
# PI_PROFILE=default_or

# Clinical-context MCP servers. Reads ./.mcp.json by default.
# PI_MCP_CONFIG=/path/to/mcp.json
# PI_MCP=off                            # disable, use transcript-only context

# LLM provider. Auto-detected: Vertex AI if Google ADC is configured
# (`gcloud auth application-default login`), else Groq if GROQ_API_KEY is set, else Ollama.
# PI_PROVIDER=vertex | groq | gemini | ollama
# PI_MODEL=gemini-2.5-flash            # vertex / gemini default
# PI_MODEL=qwen/qwen3.8-27b            # groq
# PI_MODEL=qwen2.5:3b                  # ollama
# PI_CRITIC_MODEL=gemini-2.5-flash-lite   # optional cheaper model for critic checks

# Vertex AI (pip install '.[vertex]'). Project/location default to ADC / us-central1.
# PI_VERTEX_PROJECT=
# PI_VERTEX_LOCATION=us-central1
GROQ_API_KEY=
GEMINI_API_KEY=

# Speech-to-text (only used when the input is audio/video).
# PI_STT=groq | assemblyai | deepgram | local
# PI_WHISPER_MODEL=whisper-large-v3
# PI_WHISPER_TASK=transcribe | translate
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=

# Tuning. Groq's free tier caps throughput at 8,000 tokens/minute.
# Long transcripts: PI_MIN_SPACING=19 PI_WINDOW_TURNS=90 PI_SWEEP_CHUNK=300
# PI_MIN_SPACING=5.0
# PI_WINDOW_TURNS=60
# PI_SWEEP_CHUNK=220
# PI_MAX_PROMPT_CHARS=11000
# PI_CONCURRENCY=1
# PI_RETRIES=4
# PI_MAX_BACKOFF=40
# PI_TIMEOUT=150
# OLLAMA_HOST=http://localhost:11434
